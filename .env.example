# Copia a .env.local y rellena. .env.local está en .gitignore.

# ── Base de datos (Neon) ────────────────────────────────────────────────────
# Neon → Project → Connection string → usa la variante "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Sesión del panel ────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ── Archivos (Vercel Blob) ──────────────────────────────────────────────────
# Vercel → Storage → Blob → Connect. En local: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=""
