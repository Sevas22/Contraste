# Copia a .env.local y rellena. .env.local está en .gitignore.

# ── Base de datos (Neon) ────────────────────────────────────────────────────
# Neon → Project → Connection string → usa la variante "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Sesión del panel ────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ── Archivos (Vercel Blob) ──────────────────────────────────────────────────
# Vercel → Storage → Blob → Connect. En local: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=""

# ── Medición: GTM + GA4 + Clarity ───────────────────────────────────────────
# Vacías = esa herramienta no se carga. Sólo miden en producción.
# tagmanager.google.com → contenedor del sitio (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=""
# ⚠️ GA4: o aquí, o como etiqueta dentro de GTM. Las dos a la vez = doble conteo.
# Con GTM en marcha, dejar esta VACÍA y configurar GA4 desde el contenedor.
# GA4 → Administrar → Flujos de datos → Web → "ID de medición" (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""
# clarity.microsoft.com → tu proyecto → Settings → Overview → Clarity ID
NEXT_PUBLIC_CLARITY_ID=""

# ── Verificación de propiedad (etiqueta <meta>) ─────────────────────────────
# Se leen en BUILD: si faltan en Vercel, el HTML sale sin la etiqueta.
# Search Console → Añadir propiedad → Prefijo de URL → Etiqueta HTML
# Pegar sólo el valor del content, no la etiqueta entera.
GOOGLE_SITE_VERIFICATION=""
# Opcional (fase GEO). Bing Webmaster Tools → Verificar → Etiqueta meta
BING_SITE_VERIFICATION=""

# ── Sólo desarrollo ─────────────────────────────────────────────────────────
# "json" = leer content/*.json aunque haya DATABASE_URL. Para probar contenido
# nuevo en local sin cargarlo a Neon, que es la misma base de producción.
# CONTENT_SOURCE="json"
